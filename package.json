{
  "name": "nee3",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "./start.sh",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-unknown",
    "build": "npm run build --workspace=packages/shared-types && npm run build --workspace=client",
    "test": "npm run test --workspace=backend"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
